# eCourtSolutionUI — environment variables
# Copy this file to .env and fill in your values.

# URL of the running eCourtSolution backend
VITE_API_URL=http://localhost:8000

# API key issued by the backend (see scripts/create_api_key.py in the backend project)
VITE_API_KEY=your_api_key_here

# Set to 'false' to send requests to the live backend instead of using built-in mock data
VITE_USE_MOCK=true

# Set to 'false' to hide the Mock/Live toggle from the header in production builds.
# In dev/staging leave it as 'true' for easy switching during demos.
VITE_SHOW_MOCK_TOGGLE=true
